# ─────────────────────────────────────────────
# SecureBank — Environment Variables
# Copy this file to .env.local and fill in your values.
# ─────────────────────────────────────────────

# Your Descope Project ID (Console → Project Settings)
NEXT_PUBLIC_DESCOPE_PROJECT_ID=

# UC4–UC5: Login flow ID (import flows/sign-up-or-in-bank.json or flows/sign-up-or-in-bank_otp.json)
NEXT_PUBLIC_DESCOPE_FLOW_LOGIN=

# UC1: Management key for the user migration script (Console → Company → Management Keys)
DESCOPE_MANAGEMENT_KEY=
